{
  "version": 1,
  "entryPoint": "agents/00-campaign-orchestrator.md",
  "recommendedOrder": [
    "campaign-director",
    "creative-director",
    "copywriter",
    "motion-designer",
    "visual-engineer",
    "sound-designer",
    "frontend-engineer",
    "audio-engineer",
    "brand-guardian",
    "visual-qa-director",
    "quality-auditor",
    "av-quality-auditor",
    "performance-auditor"
  ],
  "agents": [
    {
      "id": "campaign-director",
      "prompt": "agents/06-campaign-director.md",
      "role": "estrategia y storyboard",
      "inputs": ["CampaignBrief"],
      "outputs": ["CampaignPlan"],
      "invokeFor": ["CREATE", "IMPROVE"]
    },
    {
      "id": "creative-director",
      "prompt": "agents/01-creative-director.md",
      "role": "idea dominante y originalidad",
      "inputs": ["CampaignBrief", "CampaignPlan"],
      "outputs": ["CampaignConcept"],
      "invokeFor": ["CREATE", "IMPROVE", "EVOLVE"]
    },
    {
      "id": "copywriter",
      "prompt": "agents/03-copywriter.md",
      "role": "copy verificable",
      "inputs": ["CampaignConcept", "CampaignBrief"],
      "outputs": ["CampaignCopy"],
      "invokeFor": ["CREATE", "IMPROVE"]
    },
    {
      "id": "motion-designer",
      "prompt": "agents/04-motion-designer.md",
      "role": "tiempos y coreografía",
      "inputs": ["CampaignConcept", "CampaignCopy"],
      "outputs": ["MotionPlan", "TransformationMap", "CameraPath", "TransitionCheckpoints"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT"]
    },
    {
      "id": "frontend-engineer",
      "prompt": "agents/05-frontend-engineer.md",
      "role": "implementación y formatos",
      "inputs": ["MotionPlan", "CampaignCopy"],
      "outputs": ["CampaignImplementation"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT"]
    },
    {
      "id": "visual-engineer",
      "prompt": "agents/09-visual-engineer.md",
      "role": "selección de medio y visuales avanzados",
      "inputs": ["CampaignConcept", "MotionPlan", "VisualDecision"],
      "outputs": ["VisualImplementationPlan"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT"]
    },
    {
      "id": "sound-designer",
      "prompt": "agents/10-sound-designer.md",
      "role": "dirección sonora y silencios",
      "inputs": ["CampaignConcept", "MotionPlan"],
      "outputs": ["SoundPlan"],
      "invokeFor": ["CREATE", "IMPROVE"]
    },
    {
      "id": "audio-engineer",
      "prompt": "agents/11-audio-engineer.md",
      "role": "audio sincronizado y exportación",
      "inputs": ["SoundPlan", "MotionPlan"],
      "outputs": ["AudioImplementation"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT"]
    },
    {
      "id": "brand-guardian",
      "prompt": "agents/02-brand-guardian.md",
      "role": "autoridad visual",
      "inputs": ["CampaignImplementation", "CampaignConcept"],
      "outputs": ["BrandReview"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT", "EVOLVE"]
    },
    {
      "id": "quality-auditor",
      "prompt": "agents/07-quality-auditor.md",
      "role": "calidad y claims",
      "inputs": ["CampaignImplementation", "BrandReview"],
      "outputs": ["QualityReview"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT"]
    },
    {
      "id": "visual-qa-director",
      "prompt": "agents/12-visual-qa-director.md",
      "role": "revisión de checkpoints y composición",
      "inputs": ["CampaignImplementation", "CampaignPlan"],
      "outputs": ["VisualQAReview"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT"]
    },
    {
      "id": "av-quality-auditor",
      "prompt": "agents/13-av-quality-auditor.md",
      "role": "revisión conjunta de video y audio",
      "inputs": ["CampaignImplementation", "AudioImplementation", "VisualQAReview"],
      "outputs": ["AVReview"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT"]
    },
    {
      "id": "performance-auditor",
      "prompt": "agents/08-performance-auditor.md",
      "role": "rendimiento",
      "inputs": ["CampaignImplementation"],
      "outputs": ["PerformanceReview"],
      "invokeFor": ["CREATE", "IMPROVE", "ADAPT"]
    }
  ],
  "selectionRules": {
    "CREATE": "Por defecto Motion Designer crea una master composition continua con beats, transformación y permanencia. Usar escenas discretas sólo con justificación explícita.",
    "IMPROVE": "Traducir pedidos como slides/dashboard/estático/orgánico/cámara a permanencia, transformaciones causales, coreografía de cámara y transition checkpoints. Invocar concepto/copy sólo si cambia idea o mensaje; siempre auditar el resultado.",
    "ADAPT": "Conservar concepto y copy; revisar composición, implementación y calidad por ratio.",
    "EVOLVE": "Propuesta de marca y Brand Guardian; nunca aplicar cambios permanentes automáticamente."
  }
}
